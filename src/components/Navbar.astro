---
import { Menu, X } from '@lucide/astro';
---
<header x-data="{ isOpen: false }" class="fixed top-5 w-full max-w-[920px] mx-auto left-0 right-0 z-10 px-4">
    <div class="flex flex-col lg:flex-row justify-between items-center mx-auto p-5 border border-gray-300 rounded-4xl bg-white-transparent backdrop-blur-xl">
      <div class="w-full lg:w-auto flex justify-between items-center">
        <a href="/" class="flex justify-center items-center gap-2">
          <img src="/images/logo-elbaf-footer.webp" alt="logo-ellenka" class="w-[52px]">
        </a>

        <!-- Toggle Button Mobile -->
        <button @click="isOpen = !isOpen" type="button" class="block lg:hidden text-gray-800 focus:outline-none">
          <!-- Ikon Menu (Hamburger) -->
          <Menu x-show="!isOpen" />

          <!-- Ikon Close (X) -->
          <X x-show="isOpen" x-cloak/>
        </button>
      </div>

      <!-- Menu Desktop -->
      <div class="hidden lg:flex gap-2.5 justify-end items-center">
        <a href="/#about" class="font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all">About Event</a>
        
        <!-- Dropdown Champion Desktop -->
        <div 
          x-data="{ open: false }" 
          @mouseenter="open = true" 
          @mouseleave="open = false" 
          class="relative flex flex-col gap-2.5"
        >
          <button 
            type="button"
            class="font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all cursor-pointer"
          >
            Champion
          </button>

          <div 
            x-cloak
            x-show="open"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 scale-95 -translate-y-2"
            x-transition:enter-end="opacity-100 scale-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 scale-100 translate-y-0"
            x-transition:leave-end="opacity-0 scale-95 -translate-y-2"
            class="flex flex-col gap-2.5 absolute top-[60px] z-50"
          >
            <a href="/baristas/local-champion" class="font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-start rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all whitespace-nowrap w-fit">Local Champion</a>
            <a href="/baristas/semifinalists" class="font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-start rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all whitespace-nowrap w-fit">Top 18 Semifinalist</a>
            <a href="/baristas/grandfinalists" class="font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-start rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all whitespace-nowrap w-fit">Grand Finalist</a>
          </div>
        </div>

        <!-- Dropdown Rules Desktop -->
        <div 
          x-data="{ open: false }" 
          @mouseenter="open = true" 
          @mouseleave="open = false" 
          class="relative flex flex-col gap-2.5"
        >
          <button 
            type="button"
            class="font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all cursor-pointer"
          >
            Rules &amp; Regulation
          </button>

          <div 
            x-cloak
            x-show="open"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 scale-95 -translate-y-2"
            x-transition:enter-end="opacity-100 scale-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 scale-100 translate-y-0"
            x-transition:leave-end="opacity-0 scale-95 -translate-y-2"
            class="flex flex-col gap-2.5 absolute top-[60px] z-50"
          >
            <a href="/rules/rules-regional" class="font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-start rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all whitespace-nowrap w-fit">Regional Jakarta</a>
            <a href="/rules/rules-nasional" class="font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-start rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all whitespace-nowrap w-fit">Nasional</a>
          </div>
        </div>

        <a href="/newsupdate" class="font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all">News Update</a>
      </div>

      <!-- Menu Mobile -->
      <div 
        x-data="{ rulesOpen: false, championOpen: false }"
        x-show="isOpen" 
        x-cloak 
        x-transition:enter="transition ease-out duration-200" 
        x-transition:enter-start="opacity-0 -translate-y-2" 
        x-transition:enter-end="opacity-100 translate-y-0" 
        x-transition:leave="transition ease-in duration-150" 
        x-transition:leave-start="opacity-100 translate-y-0" 
        x-transition:leave-end="opacity-0 -translate-y-2" 
        @click.outside="isOpen = false" 
        class="w-full p-2 bg-blue-primary flex lg:hidden flex-col gap-2.5 justify-end items-center rounded-[20px] mt-6"
      >
        <!-- About Event -->
        <a 
          @click="isOpen = false" 
          href="/#about" 
          class="w-full font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all"
        >
          About Event
        </a>

        <!-- Accordion Champion Menu -->
        <div class="w-full flex flex-col gap-2.5">
          <button 
            @click="championOpen = !championOpen" 
            type="button"
            class="w-full font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Champion</span>
          </button>

          <div 
            x-show="championOpen"
            x-cloak
            class="flex flex-col gap-2.5 p-3 rounded-2xl bg-[#024f73] w-full"
          >
            <a 
              @click="isOpen = false" 
              href="/baristas/local-champion" 
              class="w-full font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all"
            >
              Local Champion
            </a>
            <a 
              @click="isOpen = false" 
              href="/baristas/semifinalists" 
              class="w-full font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all"
            >
              Top 18 Semifinalist
            </a>
            <a 
              @click="isOpen = false" 
              href="/baristas/grandfinalists" 
              class="w-full font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all"
            >
              Grand Finalist
            </a>
          </div>
        </div>

        <!-- Accordion Rules & Regulation Menu -->
        <div class="w-full flex flex-col gap-2.5">
          <button 
            @click="rulesOpen = !rulesOpen" 
            type="button"
            class="w-full font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Rules &amp; Regulation</span>
          </button>

          <div 
            x-show="rulesOpen"
            x-cloak
            class="flex flex-col gap-2.5 p-3 rounded-2xl bg-[#024f73] w-full"
          >
            <a 
              @click="isOpen = false" 
              href="/rules/rules-regional" 
              class="w-full font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all"
            >
              Regional Jakarta
            </a>
            <a 
              @click="isOpen = false" 
              href="/rules/rules-nasional" 
              class="w-full font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all"
            >
              Nasional
            </a>
          </div>
        </div>

        <!-- News Update -->
        <a 
          @click="isOpen = false" 
          href="/newsupdate" 
          class="w-full font-dx-monstral uppercase text-yellow-secondary text-stroke-brown text-shadow-brown text-center rounded-[28px] px-[20px] py-[9px] bg-yellow-primary border-[2px] border-brown-primary hover:bg-green-primary hover:text-yellow-primary transition-all"
        >
          News Update
        </a>
      </div>
    </div>
  </header>