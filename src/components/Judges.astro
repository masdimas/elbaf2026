<section id="judges" class="bg-blue-primary relative">
    <div class="flex flex-col gap-8 justify-center align-center py-[80px] px-4 grow">
      <span class="uppercase font-dx-monstral text-white text-[40px] text-center text-stroke-red leading-[40px] tracking-[0.5px]" data-aos="fade-up">Meet Our Judges</span>
      <div class="flex flex-col flex-nowrap w-full max-w-8xl h-auto m-auto md:flex-row gap-8 items-center md:overflow-x-auto no-scrollbar py-8 px-4 grow md:[&>div:nth-child(odd)]:rotate-[-3deg] md:[&>div:nth-child(even)]:rotate-[2deg]">
        <!-- Judges 1 -->
        <div class="w-full max-w-[380px] shrink-0 flex flex-col rounded-2xl border-4 border-brown-primary shadow-box-mechanism overflow-clip md:first:ml-auto md:last:mr-auto" data-aos="fade-up">
          <div class="bg-white flex gap-4 p-3 border-b-[1px] border-brown-primary">
            <div class="aspect-square w-[80px] h-[80px] shrink-0 overflow-hidden shadow-judge-image">
              <img src="/images/judges-1.webp" alt="judge-1" class="w-full h-full object-cover">
            </div>
            <div class="flex flex-col gap-3">
              <span class="uppercase font-oxanium-regular text-white text-xs tracking-[0.5px] leading-3.5 px-1 py-0.5 bg-green-secondary w-fit">Head
                Judge</span>
              <span class="uppercase font-dx-monstral text-black text-[24px] sm:text-[32px] tracking-[0.5px] leading-6 sm:leading-8 line-clamp-2">Viki Raharja Viki Raharja Viki Raharja Viki Raharja</span>
              <span class="uppercase font-oxanium-regular text-black text-xs tracking-[0.5px] mt-[-8px]">Barista Trainer / Latte
                Art Professional</span>
            </div>
          </div>
          <div class="bg-white p-6">
            <span class="font-qalited-rough-regular text-black text-base tracking-[0.5px]">Coffee professional Indonesia yang dikenal dalam bidang latte art, barista training, dan coffee education. Berpengalaman sebagai trainer sekaligus juri dalam berbagai kompetisi dan event kopi di Indonesia.</span>
          </div>
          <div class="bg-brown-secondary p-6">
            <div class="flex items-center gap-1.5">
              <img src="/images/award.svg" alt="award-icon">
              <span class="uppercase font-oxanium-bold text-black text-xs">Pencapaian Utama</span>
            </div>
            <ul class="">
              <li>Latte Art Champion 2016</li>
              <li>Barista Trainer & Latte Art Professional — Toffin Indonesia</li>
              <li>Judge — V-Soy Barista Soylution Competition</li>
              <li>Judge — Davinci Barista Craft Championship 2024</li>
              <li>Berpengalaman sebagai coffee educator & latte art specialist dalam berbagai event industri kopi</li>
            </ul>
          </div>
        </div>

        <!-- Judges 2  -->
        <div class="w-full max-w-[380px] shrink-0 flex flex-col rounded-2xl border-4 border-brown-primary shadow-box-mechanism overflow-clip md:first:ml-auto md:last:mr-auto" data-aos="fade-up">  
          <div class="bg-white flex gap-4 p-3 border-b-[1px] border-brown-primary">
