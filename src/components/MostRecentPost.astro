    </div>

    <script async src="https://www.instagram.com/embed.js"></script>
  </section>

  <script>
    import Swiper from 'swiper';
    import { Navigation } from 'swiper/modules';

const recentSwiper = new Swiper('.recentPostSwiper', {
  slidesPerView: 1,
  spaceBetween: 16,
  centeredSlides: true,
  loop: false,
  modules: [Navigation],

  // 1. MENCEGAH SWIPER MEMBLOKIR TAP/CLICK DI MOBILE
  touchStartPreventDefault: false,
  passiveListeners: true,

  // 2. MENCEGAH SERANGKAIAN DRAG ACCIDENTAL DARI IFRAME
  touchEventsTarget: 'wrapper', // Menargetkan drag pada wrapper, bukan langsung ke iframe
  noSwiping: true,
  noSwipingClass: 'swiper-no-swiping', // Memungkinkan area tertentu di-click tanpa menolak swipe di luar area tersebut

  observer: true,
  observeParents: true,

  navigation: {
    nextEl: '.recent-next',
    prevEl: '.recent-prev',
  },

  breakpoints: {
    640: {
      slidesPerView: 'auto',
      centeredSlides: false,
      spaceBetween: 24,
    }
  },
});
  </script>